<?xml version="1.0" encoding="utf-8"?>
<!-- Orta (4x2) ve ilk yerleşim: solda fotoğraflar, sağda sayaç ve kart.
     Kimlikler üç yerleşimde ortaktır (CoupleWidgetProvider hepsine yazar); kullanılmayanlar gizli. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/couple_widget_bg"
    android:clipToOutline="true"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/content_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/couple_widget_avatar_ring"
                    android:padding="2dp">

                    <TextView
                        android:id="@+id/avatar_me_initial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/couple_widget_initial_bg"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="♥"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp" />

                    <ImageView
                        android:id="@+id/avatar_me_img"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="-14dp"
                    android:background="@drawable/couple_widget_avatar_ring"
                    android:padding="2dp">

                    <TextView
                        android:id="@+id/avatar_partner_initial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/couple_widget_initial_bg"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="♥"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp" />

                    <ImageView
                        android:id="@+id/avatar_partner_img"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@drawable/couple_widget_badge_bg"
                android:contentDescription="@null"
                android:padding="5dp"
                android:src="@drawable/ic_couple_widget_heart" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.14"
                android:maxLines="1"
                android:text="AŞKIMIZIN YOLCULUĞU"
                android:textColor="#FFC2D4"
                android:textSize="9sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="—"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp" />

                <TextView
                    android:id="@+id/widget_days_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="gün"
                    android:textColor="#FFC2D4"
                    android:textSize="15sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_days_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="birlikte ♥"
                android:textColor="#DCCBE6"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_mood"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/couple_widget_chip_bg"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:paddingStart="9dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="4dp"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/chip_milestone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/couple_widget_chip_bg"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:paddingStart="9dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="4dp"
                    android:text=""
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/message_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/message_emoji"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/couple_widget_icon_bg"
            android:gravity="center"
            android:text="♥"
            android:textColor="#FF5C8A"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/message_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:maxLines="1"
            android:text="Couples App"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/message_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="2"
            android:text="Açmak için dokun"
            android:textColor="#DCCBE6"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/message_cta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/couple_widget_chip_bg"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
