<?xml version="1.0" encoding="utf-8"?>
<!-- keyguard: kilit ekranı widget alanı destekleyen sistemlerde (Android 16 QPR1+ AOSP kilit ekranı,
     tabletlerde widget merkezi, keyguard kategorisine bakan üretici kilit ekranları) eklenebilir.
     not_keyguard kullanılmaz: o kategori widget'ı kilit ekranından gizler. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/couple_widget_description"
    android:initialLayout="@layout/couple_widget"
    android:minHeight="110dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="110dp"
    android:minWidth="250dp"
    android:previewLayout="@layout/couple_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="3600000"
    android:widgetCategory="home_screen|keyguard" />
