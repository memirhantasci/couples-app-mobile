{
  "expo": {
    "name": "CoupleSky",
    "slug": "emirhan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "couplesapp",
    "userInterfaceStyle": "dark",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/41ae72c5-4b30-4fd6-92f5-4191dd8c0b4c",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": false,
      "bundleIdentifier": "app.couplesky.mobile",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Partnerinden mektup geldiğinde veya özel bir günün yaklaştığında seni haberdar etmek için bildirim göndermek istiyoruz.",
        "NSCameraUsageDescription": "Anılarına fotoğraf ekleyebilmek için kameraya erişmemiz gerekiyor.",
        "NSPhotoLibraryUsageDescription": "Anılarına fotoğraf ekleyebilmek için fotoğraf kütüphanesine erişmemiz gerekiyor.",
        "NSLocationWhenInUseUsageDescription": "Buluşma noktası seçerken mevcut konumunuzu haritada gösterebilmek için konum erişimi gereklidir.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "instagram",
          "instagram-stories"
        ],
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "app.couplesky.mobile",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD0x9bja7CzbqjIAbLqbsl-7TlqbOi_sL0"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-web-browser",
      "expo-image",
      "expo-asset",
      "expo-apple-authentication",
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "CoupleWidget",
              "displayName": "CoupleSky",
              "description": "Kaç gündür birlikte olduğunuzu, çift fotoğrafınızı, sevgilinin ruh halini ve yaklaşan yıl dönümünüzü ana ekranda ve kilit ekranında görün. · See how many days you've been together, your couple photo, your love's mood and your upcoming anniversary on your home and lock screen.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "contentMarginsDisabled": true
              }
            }
          ]
        }
      ],
      "./plugins/withAndroidWidget",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#E8002D",
          "defaultChannel": "default",
          "sounds": [],
          "androidCollapsedTitle": "CoupleSky"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3252755330955913~9048294899",
          "iosAppId": "ca-app-pub-3252755330955913~4646015458"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Buluşma noktası seçerken mevcut konumunuzu haritada gösterebilmek için konum erişimi gereklidir."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "41ae72c5-4b30-4fd6-92f5-4191dd8c0b4c"
      }
    },
    "owner": "memirhantascis-team",
    "locales": {
      "tr": "./locales/native/tr.json",
      "en": "./locales/native/en.json"
    }
  }
}
